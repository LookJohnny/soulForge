{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoulForge Live",
  "version": "0.1.0",
  "identifier": "cn.lovelyjoy.soulforge.live",
  "build": {
    "devUrl": "http://127.0.0.1:8899",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SoulForge Live",
        "url": "http://127.0.0.1:8899/live?model=AvatarSample_B",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "SoulForge Companion",
        "url": "http://127.0.0.1:8899/live?transparent=1&hud=0&model=AvatarSample_B",
        "width": 420,
        "height": 640,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
