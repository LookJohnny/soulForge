{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SoulForge Live pages (served by studio/server.py) may drive the windows.",
  "remote": {
    "urls": [
      "http://127.0.0.1:8899/*",
      "http://localhost:8899/*"
    ]
  },
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-start-native-mic",
    "allow-stop-native-mic",
    "allow-start-drag",
    "allow-show-overlay",
    "allow-hide-overlay",
    "allow-toggle-overlay"
  ]
}
