# ═══════════════════════════════════════════════
# SoulForge 环境变量配置模板
# 复制为 .env 并填入实际值
# ═══════════════════════════════════════════════

# ─── 环境标识 ───────────────────────────────
# development | production
ENVIRONMENT=development

# ─── Database ───────────────────────────────
DATABASE_URL=postgresql://soulforge:soulforge_dev@localhost:5432/soulforge

# ─── Redis ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Milvus (向量数据库，RAG 用) ────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ─── MinIO (对象存储) ──────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# ─── DashScope (阿里云 AI) ─────────────────
# 获取: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ─── LLM 大模型 ────────────────────────────
# 可选: dashscope, deepseek, moonshot, glm, openai, ollama
LLM_PROVIDER=dashscope
LLM_MODEL=qwen2.5-7b-instruct
LLM_TIMEOUT=30
# LLM_BASE_URL=          # 自定义 API 地址（可选）
# LLM_API_KEY=           # 自定义 Key（可选，默认用 DASHSCOPE_API_KEY）
# LLM_TEMPERATURE=0.8
# LLM_TOP_P=0.9
# LLM_MAX_TOKENS=512

# ─── TTS 语音合成 ──────────────────────────
# 可选: fish, dashscope, edge
TTS_PROVIDER=fish
TTS_TIMEOUT=15
# TTS_MODEL=cosyvoice-v3-flash   # dashscope 音色模型
# TTS_STREAMING=true             # 流式 TTS（更低首音延迟），false 回退整段合成

# ─── Fish Audio (声优级 TTS) ─────────────
# 获取: https://fish.audio/
FISH_AUDIO_API_KEY=your-fish-audio-api-key
FISH_AUDIO_MODEL=s1

# ─── ASR 语音识别 ──────────────────────────
ASR_PROVIDER=dashscope
ASR_TIMEOUT=10
# ASR_MODEL=paraformer-realtime-v2

# ─── RAG 检索 ──────────────────────────────
# RAG_TOP_K=3
# RAG_SCORE_THRESHOLD=0.7
# RAG_EMBEDDING_MODEL=text-embedding-v3
# RAG_EMBEDDING_DIM=1024

# ─── AI Core 服务地址 ──────────────────────
AI_CORE_URL=http://127.0.0.1:8100

# ─── 认证 & 安全 ──────────────────────────
# NextAuth 密钥 (admin-web 和 ai-core 共享)
# 生成: openssl rand -base64 32
# 如果你要从局域网内其他设备访问管理后台，
# 这里必须填当前机器可达的 IP/主机名，不能写 localhost。
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# Gateway → ai-core 内部服务令牌
# 生成: openssl rand -base64 32
SERVICE_TOKEN=change-me

# Public inference / gateway control token. Keep server-side; never put in JS.
# Missing token disables /v1/chat/completions and /admin/runtime-agent (503).
# Generate separately: openssl rand -hex 32
GATEWAY_API_TOKEN=

# SoulPack 加密主密钥
# ⚠️ 生产环境必须修改，禁止默认值
# 生成: openssl rand -base64 32
MASTER_SECRET=change-me-in-production

# ─── CORS 跨域白名单 ───────────────────────
# 逗号分隔；开发环境留空默认允许 localhost
# 生产环境必须配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── 限流 ──────────────────────────────────
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_TTS=20/minute
RATE_LIMIT_DEFAULT=60/minute

# ─── Gateway ───────────────────────────────
GATEWAY_PORT=8081
OUTPUT_AUDIO_GAIN=1.0
# OTA 回退地址：请求缺少 Host 头时返回给设备的 WS 地址
# 填设备可达的局域网 IP，如 192.168.1.172:8080；留空则用 localhost:<GATEWAY_PORT>
# OTA_FALLBACK_HOST=
# OTA_TIMEZONE_OFFSET_MIN=480    # 报告给设备的时区偏移（分钟）
# IDLE_TIMEOUT_S=120             # 连接空闲多久后断开

# ─── 语音检测 / 打断（按设备环境调参） ─────
# VAD_SPEECH_PROB_THRESHOLD=0.5  # Silero 语音概率阈值
# VAD_SPEECH_START_FRAMES=3      # 连续有声帧数确认开口
# VAD_SILENCE_END_FRAMES=20      # 连续静音帧数确认说完 (~640ms)
# BARGE_IN_RMS_THRESHOLD=12000   # 打断能量阈值（须高于扬声器回声 3000-8000）
# BARGE_IN_SUSTAIN_FRAMES=8      # 持续高能量帧数 (~500ms) 才算打断

# ─── Unified Character Runtime / scripts/live-up.sh ────
# The launcher reads this root .env for every service; file values win over
# stale shell exports during ordinary launches (no shell code is evaluated).
# check/--dry-run validates without starting processes or calling providers.
CHARACTER_RUNTIME_URL=ws://127.0.0.1:8765
CHARACTER_RUNTIME_AGENT=joi
CHARACTER_RUNTIME_TIMEOUT_S=35
SOULFORGE_COGNITION_URL=http://127.0.0.1:8100
SOULFORGE_COGNITION_TIMEOUT_S=25
SOULFORGE_MEMORY_BACKEND=ai-core
# Durable SQLite queue for writes awaiting AI Core acknowledgement; keep across restarts.
# Default: outputs/runtime-memory/<brand UUID>/<user UUID>/outbox.sqlite3
# SOULFORGE_MEMORY_OUTBOX=outputs/runtime-memory/custom-outbox.sqlite3
# Existing brand UUID; no shared development default is used.
SOULFORGE_BRAND_ID=
# Optional existing user UUID; absent => deterministic user for this brand.
SOULFORGE_USER_ID=
STUDIO_PORT=8899
RUNTIME_TIME_SCALE=2
RUNTIME_LLM_TIMEOUT=30
# Nested time limits: gateway 35s > Runtime decision 30s > AI Core HTTP 25s.
RUNTIME_SOCIAL=false
# CHARACTER_RUNTIME_VOICE_DEVICE_ID=

# Optional public HTTP-only tunnel: none | ngrok | cloudflared.
# Only /v1/chat/completions and /health are routed. WS/control stay local.
LIVE_TUNNEL_PROVIDER=none
LIVE_TUNNEL_PORT=8091
# NGROK_DOMAIN=                    # reserved domain, if your ngrok account has one
# cloudflared startup discovers the current URL from new tunnel log output and
# persists TAVUS_PUBLIC_BASE_URL here (0600). Configure this yourself for ngrok.
# TAVUS_PUBLIC_BASE_URL=https://your-public-host
# TAVUS_API_KEY=                   # only scripts/tavus_setup.py uses this key
# Optional external configuration update after a tunnel starts; sync patches
# only the existing PAL custom LLM layer, never creates a PAL/conversation.
TAVUS_SYNC_ON_START=false
# TAVUS_PAL_ID=                    # existing PAL; fallback: outputs/tavus.json

# .soul 导入时镜像到 ai-core 角色表所用的品牌 id（留空 = 只写 configs/characters.json）
SOUL_BRAND_ID=

# 引擎 LLM 双车道：用户对话/决策（延迟优先）与角色互聊（质量优先，可用更慢的模型）
# BEHAVIOR_LLM_BASE_URL=https://api.deepseek.com/v1
# BEHAVIOR_LLM_MODEL=deepseek-chat
CONVERSATION_LLM_MODEL=deepseek-reasoner
# CONVERSATION_LLM_BASE_URL= / CONVERSATION_LLM_API_KEY=   # 换厂商时才需要

# Self-hosted real video body: /joi?body=selfhost. GPU worker is deployed separately.
# Install the CPU transport once: scripts/selfhost-up.sh --install
# true adds the process to live-up.sh; readiness still requires a loaded real GPU.
SELFHOST_MEDIA_ENABLED=false
SELFHOST_MEDIA_PORT=8902
SELFHOST_MEDIA_URL=http://127.0.0.1:8902
SELFHOST_MEDIA_TOKEN=
# Remote GPU must use HTTPS or an SSH loopback forward. Never expose an unauthenticated worker.
AVATAR_WORKER_URL=http://127.0.0.1:8092
AVATAR_WORKER_TOKEN=
# Worker-side image/checkpoint/CUDA configuration: docs/self-hosted-gpu-worker.md
