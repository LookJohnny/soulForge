generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────

enum CharacterArchetype {
  ANIMAL        // 动物角色 (毛绒玩具) — "一只小猫"
  HUMAN         // 人类角色 (老师/朋友/偶像) — "一位温柔的姐姐"
  FANTASY       // 幻想角色 (精灵/机器人) — "一个来自星空的精灵"
  ABSTRACT      // 抽象助手 (无具体形象) — 纯语音助手
}

enum CharacterStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResponseLength {
  SHORT
  MEDIUM
  LONG
}

enum DeviceStatus {
  ACTIVE
  OFFLINE
  MAINTENANCE
}

enum LicenseTier {
  FREE
  TRIAL
  PRO
  ENTERPRISE
}

enum UsageType {
  CONVERSATION
  TTS_CALL
  LLM_TOKEN
}

enum MemoryType {
  TOPIC
  PREFERENCE
  EVENT
}

enum MemoryLayer {
  PROFILE
  EPISODIC
  SEMANTIC
  RELATIONAL
}

enum SensitivityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MemoryPermissionLevel {
  AUTO
  CONFIRMED
  PENDING_CONFIRMATION
  DENIED
}

enum MemoryConflictStatus {
  NONE
  POTENTIAL
  CONFIRMED_CONFLICT
  SUPERSEDED
}

enum MemoryUseMode {
  DIRECT_SURFACE
  IMPLICIT_ONLY
  REQUIRE_CONFIRMATION
  BLOCKED
}

enum RelationshipStage {
  STRANGER
  ACQUAINTANCE
  FAMILIAR
  FRIEND
  BESTFRIEND
}

enum LanguageMode {
  VERBAL      // 正常说话的角色（默认）
  VOCALIZED   // 只用拟声词/音节表达（咕咕嘎嘎企鹅 / doro）
}

// ─── Brand / Tenant ────────────────────────────────

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  logo      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  characters Character[]
  users      User[]
  licenses   License[]
  apiKeys    ApiKey[]
  soulPacks  SoulPack[]

  @@map("brands")
}

// ─── Users (B-end designers + admin) ───────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  brandId         String    @map("brand_id") @db.Uuid
  email           String    @unique @db.VarChar(200)
  name            String    @db.VarChar(100)
  hashedPassword  String    @map("hashed_password") @db.VarChar(200)
  role            String    @default("designer") @db.VarChar(20)
  emailVerified   DateTime? @map("email_verified")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@map("users")
}

// ─── End Users (C-end, from mini program) ──────────

model EndUser {
  id        String   @id @default(uuid()) @db.Uuid
  openId    String?  @unique @map("open_id") @db.VarChar(100)
  unionId   String?  @map("union_id") @db.VarChar(100)
  nickname  String?  @db.VarChar(50)
  avatar    String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customizations  UserCustomization[]
  devices         Device[]
  memories        ConversationMemory[]
  relationships   RelationshipState[]
  profileMemories ProfileMemory[]
  episodicMemories EpisodicMemory[]
  semanticMemories SemanticMemory[]
  relationalMemories RelationalMemory[]
  rawEventLogs RawEventLog[]
  memoryPolicies MemoryPolicy[]
  memoryReflections MemoryReflection[]
  compiledBehaviorRules CompiledBehaviorRule[]
  memoryUsageLogs MemoryUsageLog[]
  memoryPendingConfirmations MemoryPendingConfirmation[]

  @@map("end_users")
}

// ─── Character (designer-authored soul config) ─────

model Character {
  id             String          @id @default(uuid()) @db.Uuid
  brandId        String          @map("brand_id") @db.Uuid
  name           String          @db.VarChar(50)
  archetype      CharacterArchetype @default(ANIMAL)
  species        String?         @db.VarChar(30)   /// 动物种类(ANIMAL) 或角色描述(HUMAN/FANTASY)
  ageSetting     Int?            @map("age_setting")
  backstory      String?         @db.Text
  relationship   String?         @db.VarChar(20)
  personality    Json            @default("{}")
  catchphrases   String[]        @default([])
  suffix         String?         @db.VarChar(20)
  topics         String[]        @default([])
  forbidden      String[]        @default([])
  responseLength ResponseLength  @default(SHORT) @map("response_length")
  voiceId        String?         @map("voice_id") @db.Uuid
  voiceSpeed     Float           @default(1.0) @map("voice_speed")
  emotionConfig  Json?           @map("emotion_config")
  avatar         String?         @db.VarChar(200)
  status         CharacterStatus @default(DRAFT)
  // Sprint 2: Per-character provider overrides
  llmProvider    String?         @map("llm_provider") @db.VarChar(50)
  llmModel       String?         @map("llm_model") @db.VarChar(100)
  ttsProvider    String?         @map("tts_provider") @db.VarChar(50)
  // Sprint 4: Vocalized-language support (non-verbal characters)
  languageMode         LanguageMode @default(VERBAL) @map("language_mode")
  vocalizationPalette  String[]     @default([]) @map("vocalization_palette") /// 允许的拟声词/音节集合
  audioClips           Json?        @map("audio_clips")                        /// { "doro~": "https://.../doro.mp3" }
  voiceCloneUrl        String?      @map("voice_clone_url") @db.VarChar(500)  /// Fish Audio 声音克隆样本 URL (10s+ 原声)
  voiceCloneRefId      String?      @map("voice_clone_ref_id") @db.VarChar(64) /// Fish Audio 克隆后返回的 reference_id
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  brand          Brand              @relation(fields: [brandId], references: [id])
  voice          VoiceProfile?      @relation(fields: [voiceId], references: [id])
  customizations UserCustomization[]
  devices        Device[]
  logs           ConversationLog[]
  memories       ConversationMemory[]
  relationships  RelationshipState[]
  profileMemories ProfileMemory[]
  episodicMemories EpisodicMemory[]
  semanticMemories SemanticMemory[]
  relationalMemories RelationalMemory[]
  rawEventLogs RawEventLog[]
  memoryReflections MemoryReflection[]
  compiledBehaviorRules CompiledBehaviorRule[]
  memoryUsageLogs MemoryUsageLog[]
  memoryPendingConfirmations MemoryPendingConfirmation[]

  @@index([brandId])
  @@index([status])
  @@map("characters")
}

// ─── Voice Profile ─────────────────────────────────

model VoiceProfile {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(50)
  referenceAudio   String   @map("reference_audio") @db.VarChar(200)
  description      String?  @db.Text
  tags             String[] @default([])
  dashscopeVoiceId String?  @map("dashscope_voice_id") @db.VarChar(100)
  fishAudioId      String?  @map("fish_audio_id") @db.VarChar(64)  /// Fish Audio cloned voice reference ID
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  characters Character[]

  @@map("voice_profiles")
}

// ─── User Customization (C-end "face sculpting") ───

model UserCustomization {
  id                 String   @id @default(uuid()) @db.Uuid
  endUserId          String   @map("end_user_id") @db.Uuid
  characterId        String   @map("character_id") @db.Uuid
  deviceId           String?  @map("device_id") @db.VarChar(100)
  nickname           String?  @db.VarChar(30)
  userTitle          String?  @map("user_title") @db.VarChar(20)
  personalityOffsets Json?    @map("personality_offsets")
  personalityDrift   Json?    @map("personality_drift")
  interestTopics     String[] @default([]) @map("interest_topics")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  endUser   EndUser   @relation(fields: [endUserId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@unique([endUserId, characterId, deviceId])
  @@index([endUserId])
  @@index([characterId])
  @@map("user_customizations")
}

// ─── Device ────────────────────────────────────────

model Device {
  id            String       @id @db.VarChar(100)
  deviceType    String       @default("toy") @map("device_type") @db.VarChar(20) /// toy|earbuds|phone|desktop|speaker|web
  characterId   String?      @map("character_id") @db.Uuid
  endUserId     String?      @map("end_user_id") @db.Uuid
  deviceSecret  String?      @map("device_secret") @db.VarChar(200) /// SHA-256 hash of device secret for WebSocket auth
  firmwareVer   String?      @map("firmware_ver") @db.VarChar(20)
  hardwareModel String?      @map("hardware_model") @db.VarChar(50)
  lastSeen      DateTime?    @map("last_seen")
  status        DeviceStatus @default(OFFLINE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  character   Character?          @relation(fields: [characterId], references: [id])
  endUser     EndUser?            @relation(fields: [endUserId], references: [id])
  logs        ConversationLog[]
  activations DeviceActivation[]
  episodicMemories EpisodicMemory[]
  rawEventLogs RawEventLog[]

  @@index([characterId])
  @@index([endUserId])
  @@map("devices")
}

// ─── Conversation Log ──────────────────────────────

model ConversationLog {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @map("device_id") @db.VarChar(100)
  characterId String   @map("character_id") @db.Uuid
  sessionId   String?  @map("session_id") @db.VarChar(100)
  userInput   String   @map("user_input") @db.Text
  aiResponse  String   @map("ai_response") @db.Text
  latencyMs   Int?     @map("latency_ms")
  flagged     Boolean  @default(false)
  flagReason  String?  @map("flag_reason") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  device    Device    @relation(fields: [deviceId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@index([deviceId])
  @@index([characterId])
  @@index([createdAt])
  @@index([flagged])
  @@map("conversation_logs")
}

// ─── License (Sprint 3) ───────────────────────────

model License {
  id              String      @id @default(uuid()) @db.Uuid
  brandId         String      @map("brand_id") @db.Uuid
  tier            LicenseTier @default(FREE)
  maxCharacters   Int         @default(3) @map("max_characters")
  maxDevices      Int         @default(10) @map("max_devices")
  maxDailyConvos  Int         @default(100) @map("max_daily_convos")
  expiresAt       DateTime?   @map("expires_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@map("licenses")
}

// ─── API Key (Sprint 3) ──────────────────────────

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  brandId     String    @map("brand_id") @db.Uuid
  name        String    @db.VarChar(100)
  prefix      String    @db.VarChar(12)
  hashedKey   String    @unique @map("hashed_key") @db.VarChar(128)
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@index([hashedKey])
  @@map("api_keys")
}

// ─── Usage Record (Sprint 3) ─────────────────────

model UsageRecord {
  id        String    @id @default(uuid()) @db.Uuid
  brandId   String    @map("brand_id") @db.Uuid
  type      UsageType
  count     Int       @default(0)
  date      DateTime  @db.Date
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([brandId, type, date])
  @@index([brandId, date])
  @@map("usage_records")
}

// ─── Device Activation Audit (Sprint 3) ──────────

model DeviceActivation {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @map("device_id") @db.VarChar(100)
  action    String   @db.VarChar(20) // "activate" | "deactivate"
  reason    String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@index([createdAt])
  @@map("device_activations")
}

// ─── Soul Pack (Sprint 3) ────────────────────────

model SoulPack {
  id          String   @id @default(uuid()) @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  characterId String   @map("character_id") @db.Uuid
  version     String   @db.VarChar(20)
  checksum    String   @db.VarChar(64)
  fileUrl     String   @map("file_url") @db.VarChar(500)
  fileSize    Int      @map("file_size")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
  @@index([characterId])
  @@map("soul_packs")
}

// ─── Chat Messages (public mobile chat) ─────────

model ChatMessage {
  id          String   @id @default(uuid()) @db.Uuid
  characterId String   @map("character_id") @db.Uuid
  visitorId   String   @map("visitor_id") @db.VarChar(100)
  role        String   @db.VarChar(10) // "user" | "assistant"
  content     String   @db.Text
  action      String?  @db.Text
  thought     String?  @db.Text
  emotion     String?  @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([characterId, visitorId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ─── Conversation Memory ────────────────────────

model ConversationMemory {
  id          String     @id @default(uuid()) @db.Uuid
  endUserId   String     @map("end_user_id") @db.Uuid
  characterId String     @map("character_id") @db.Uuid
  type        MemoryType
  content     String     @db.VarChar(200)
  source      String?    @db.Text
  sessionId   String?    @map("session_id") @db.VarChar(100)
  confidence  Float      @default(1.0)
  createdAt   DateTime   @default(now()) @map("created_at")

  endUser   EndUser   @relation(fields: [endUserId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@index([endUserId, characterId])
  @@index([createdAt])
  @@map("conversation_memories")
}

// ─── Relationship State ─────────────────────

model RelationshipState {
  id                  String            @id @default(uuid()) @db.Uuid
  endUserId           String            @map("end_user_id") @db.Uuid
  characterId         String            @map("character_id") @db.Uuid
  affinity            Int               @default(0)
  stage               RelationshipStage @default(STRANGER)
  streakDays          Int               @default(0) @map("streak_days")
  lastInteractionDate DateTime?         @map("last_interaction_date") @db.Date
  turnCountToday      Int               @default(0) @map("turn_count_today")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  endUser   EndUser   @relation(fields: [endUserId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@unique([endUserId, characterId])
  @@index([endUserId])
  @@index([characterId])
  @@map("relationship_states")
}

// ─── Five-layer Companion Memory MVP ─────────────

model RawEventLog {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  characterId      String?          @map("character_id") @db.Uuid
  deviceId         String?          @map("device_id") @db.VarChar(100)
  sessionId        String?          @map("session_id") @db.VarChar(100)
  eventType        String           @map("event_type") @db.VarChar(80)
  source           String           @default("api") @db.VarChar(50)
  content          String           @db.Text
  payload          Json             @default("{}")
  context          Json             @default("{}")
  importanceScore  Int              @default(5) @map("importance_score")
  sensitivityLevel SensitivityLevel @default(LOW) @map("sensitivity_level")
  observedAt       DateTime         @default(now()) @map("observed_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  user      EndUser    @relation(fields: [userId], references: [id])
  character Character? @relation(fields: [characterId], references: [id])
  device    Device?    @relation(fields: [deviceId], references: [id])

  @@index([userId, characterId, observedAt])
  @@index([eventType])
  @@index([importanceScore])
  @@map("raw_event_logs")
}

model ProfileMemory {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  characterId          String?               @map("character_id") @db.Uuid
  memoryType           MemoryLayer           @default(PROFILE) @map("memory_type")
  key                  String                @db.Text
  content              String                @db.Text
  rawSource            Json                  @default("{}") @map("raw_source")
  timestamp            DateTime              @default(now())
  confidenceScore      Float                 @default(0.8) @map("confidence_score")
  emotionalValence     Float?                @map("emotional_valence")
  sensitivityLevel     SensitivityLevel      @default(LOW) @map("sensitivity_level")
  permissionLevel      MemoryPermissionLevel @default(AUTO) @map("permission_level")
  retrievalWeight      Float                 @default(1.0) @map("retrieval_weight")
  importanceScore      Int                   @default(5) @map("importance_score")
  decayRate            Float                 @default(0.01) @map("decay_rate")
  lastUsedAt           DateTime?             @map("last_used_at")
  usageCount           Int                   @default(0) @map("usage_count")
  updateHistory        Json                  @default("[]") @map("update_history")
  conflictStatus       MemoryConflictStatus  @default(NONE) @map("conflict_status")
  canSurfaceDirectly   Boolean               @default(false) @map("can_surface_directly")
  implicitOnly         Boolean               @default(true) @map("implicit_only")
  requiresConfirmation Boolean               @default(false) @map("requires_confirmation")
  frozenAt             DateTime?             @map("frozen_at")
  deletedAt            DateTime?             @map("deleted_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  user      EndUser    @relation(fields: [userId], references: [id])
  character Character? @relation(fields: [characterId], references: [id])

  @@unique([userId, characterId, key])
  @@index([userId, characterId])
  @@index([deletedAt])
  @@map("profile_memories")
}

model EpisodicMemory {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  characterId          String?               @map("character_id") @db.Uuid
  deviceId             String?               @map("device_id") @db.VarChar(100)
  memoryType           MemoryLayer           @default(EPISODIC) @map("memory_type")
  content              String                @db.Text
  rawSource            Json                  @map("raw_source")
  sourceLogId          String?               @map("source_log_id") @db.Uuid
  rawTranscript        Json                  @default("{}") @map("raw_transcript")
  timestamp            DateTime              @default(now())
  contextWindow        Json                  @default("{}") @map("context_window")
  detectedTopics       String[]              @default([]) @map("detected_topics")
  confidenceScore      Float                 @default(0.7) @map("confidence_score")
  emotionalValence     Float?                @map("emotional_valence")
  padSnapshot          Json?                 @map("pad_snapshot")
  sensitivityLevel     SensitivityLevel      @default(LOW) @map("sensitivity_level")
  permissionLevel      MemoryPermissionLevel @default(AUTO) @map("permission_level")
  retrievalWeight      Float                 @default(0.6) @map("retrieval_weight")
  importanceScore      Int                   @default(5) @map("importance_score")
  decayRate            Float                 @default(0.05) @map("decay_rate")
  lastUsedAt           DateTime?             @map("last_used_at")
  usageCount           Int                   @default(0) @map("usage_count")
  updateHistory        Json                  @default("[]") @map("update_history")
  conflictStatus       MemoryConflictStatus  @default(NONE) @map("conflict_status")
  canSurfaceDirectly   Boolean               @default(false) @map("can_surface_directly")
  implicitOnly         Boolean               @default(true) @map("implicit_only")
  requiresConfirmation Boolean               @default(false) @map("requires_confirmation")
  frozenAt             DateTime?             @map("frozen_at")
  deletedAt            DateTime?             @map("deleted_at")
  createdAt            DateTime              @default(now()) @map("created_at")

  user      EndUser    @relation(fields: [userId], references: [id])
  character Character? @relation(fields: [characterId], references: [id])
  device    Device?    @relation(fields: [deviceId], references: [id])

  @@index([userId, characterId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("episodic_memories")
}

model SemanticMemory {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  characterId          String?               @map("character_id") @db.Uuid
  memoryType           MemoryLayer           @default(SEMANTIC) @map("memory_type")
  content              String                @db.Text
  rawSource            Json                  @default("{}") @map("raw_source")
  sourceMemoryIds      String[]              @default([]) @map("source_memory_ids") @db.Uuid
  timestamp            DateTime              @default(now())
  confidenceScore      Float                 @default(0.75) @map("confidence_score")
  evidenceCount        Int                   @default(0) @map("evidence_count")
  emotionalValence     Float?                @map("emotional_valence")
  sensitivityLevel     SensitivityLevel      @default(LOW) @map("sensitivity_level")
  permissionLevel      MemoryPermissionLevel @default(AUTO) @map("permission_level")
  retrievalWeight      Float                 @default(0.9) @map("retrieval_weight")
  importanceScore      Int                   @default(5) @map("importance_score")
  decayRate            Float                 @default(0.02) @map("decay_rate")
  lastUsedAt           DateTime?             @map("last_used_at")
  usageCount           Int                   @default(0) @map("usage_count")
  updateHistory        Json                  @default("[]") @map("update_history")
  conflictStatus       MemoryConflictStatus  @default(NONE) @map("conflict_status")
  canSurfaceDirectly   Boolean               @default(false) @map("can_surface_directly")
  implicitOnly         Boolean               @default(true) @map("implicit_only")
  requiresConfirmation Boolean               @default(false) @map("requires_confirmation")
  frozenAt             DateTime?             @map("frozen_at")
  deletedAt            DateTime?             @map("deleted_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  user      EndUser    @relation(fields: [userId], references: [id])
  character Character? @relation(fields: [characterId], references: [id])

  @@index([userId, characterId])
  @@index([deletedAt])
  @@map("semantic_memories")
}

model RelationalMemory {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  characterId          String?               @map("character_id") @db.Uuid
  memoryType           MemoryLayer           @default(RELATIONAL) @map("memory_type")
  content              String                @db.Text
  relationAxis         String                @map("relation_axis") @db.Text
  rawSource            Json                  @default("{}") @map("raw_source")
  sourceMemoryIds      String[]              @default([]) @map("source_memory_ids") @db.Uuid
  timestamp            DateTime              @default(now())
  confidenceScore      Float                 @default(0.8) @map("confidence_score")
  emotionalValence     Float?                @map("emotional_valence")
  sensitivityLevel     SensitivityLevel      @default(LOW) @map("sensitivity_level")
  permissionLevel      MemoryPermissionLevel @default(AUTO) @map("permission_level")
  retrievalWeight      Float                 @default(1.0) @map("retrieval_weight")
  importanceScore      Int                   @default(5) @map("importance_score")
